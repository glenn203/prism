{
  "name": "@glenn203/prism",
  "version": "0.0.0",
  "description": "Prism: headless Lit web components with behavior, accessibility and form participation built in, and no visual opinions",
  "author": "Chuck Bolton",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/glenn203/prism.git"
  },
  "bugs": {
    "url": "https://github.com/glenn203/prism/issues"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "headless",
    "accessibility",
    "lit",
    "prism"
  ],
  "files": [
    "dist",
    "custom-elements.json",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*",
    "tokens/prism.tokens.json",
    "tokens/prism.tokens.resolved.json"
  ],
  "sideEffects": [
    "./dist/define.js",
    "./dist/*/define.js",
    "./dist/tokens/tokens.css",
    "./dist/theme/theme.css",
    "./dist/theme/polish.css",
    "./src/define.ts",
    "./src/*/define.ts",
    "./src/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./button": {
      "types": "./dist/button/button.d.ts",
      "import": "./dist/button/button.js"
    },
    "./button/define": {
      "types": "./dist/button/define.d.ts",
      "import": "./dist/button/define.js"
    },
    "./text-field": {
      "types": "./dist/text-field/text-field.d.ts",
      "import": "./dist/text-field/text-field.js"
    },
    "./text-field/define": {
      "types": "./dist/text-field/define.d.ts",
      "import": "./dist/text-field/define.js"
    },
    "./text-input": {
      "types": "./dist/text-input/text-input.d.ts",
      "import": "./dist/text-input/text-input.js"
    },
    "./text-input/define": {
      "types": "./dist/text-input/define.d.ts",
      "import": "./dist/text-input/define.js"
    },
    "./password-input": {
      "types": "./dist/password-input/password-input.d.ts",
      "import": "./dist/password-input/password-input.js"
    },
    "./password-input/define": {
      "types": "./dist/password-input/define.d.ts",
      "import": "./dist/password-input/define.js"
    },
    "./search-input": {
      "types": "./dist/search-input/search-input.d.ts",
      "import": "./dist/search-input/search-input.js"
    },
    "./search-input/define": {
      "types": "./dist/search-input/define.d.ts",
      "import": "./dist/search-input/define.js"
    },
    "./otp-input": {
      "types": "./dist/otp-input/otp-input.d.ts",
      "import": "./dist/otp-input/otp-input.js"
    },
    "./otp-input/define": {
      "types": "./dist/otp-input/define.d.ts",
      "import": "./dist/otp-input/define.js"
    },
    "./text-area": {
      "types": "./dist/text-area/text-area.d.ts",
      "import": "./dist/text-area/text-area.js"
    },
    "./text-area/define": {
      "types": "./dist/text-area/define.d.ts",
      "import": "./dist/text-area/define.js"
    },
    "./select": {
      "types": "./dist/select/select.d.ts",
      "import": "./dist/select/select.js"
    },
    "./select/define": {
      "types": "./dist/select/define.d.ts",
      "import": "./dist/select/define.js"
    },
    "./option": {
      "types": "./dist/option/option.d.ts",
      "import": "./dist/option/option.js"
    },
    "./option/define": {
      "types": "./dist/option/define.d.ts",
      "import": "./dist/option/define.js"
    },
    "./tokens.css": "./dist/tokens/tokens.css",
    "./theme.css": "./dist/theme/theme.css",
    "./polish.css": "./dist/theme/polish.css",
    "./polish": {
      "types": "./dist/polish/polish.d.ts",
      "import": "./dist/polish/polish.js"
    },
    "./tokens.json": "./tokens/prism.tokens.resolved.json",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json",
    "./internal/*": null,
    "./icon-button": {
      "types": "./dist/icon-button/icon-button.d.ts",
      "import": "./dist/icon-button/icon-button.js"
    },
    "./icon-button/define": {
      "types": "./dist/icon-button/define.d.ts",
      "import": "./dist/icon-button/define.js"
    },
    "./menu": {
      "types": "./dist/menu/menu.d.ts",
      "import": "./dist/menu/menu.js"
    },
    "./menu/define": {
      "types": "./dist/menu/define.d.ts",
      "import": "./dist/menu/define.js"
    },
    "./switch": {
      "types": "./dist/switch/switch.d.ts",
      "import": "./dist/switch/switch.js"
    },
    "./switch/define": {
      "types": "./dist/switch/define.d.ts",
      "import": "./dist/switch/define.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/checkbox.d.ts",
      "import": "./dist/checkbox/checkbox.js"
    },
    "./checkbox/define": {
      "types": "./dist/checkbox/define.d.ts",
      "import": "./dist/checkbox/define.js"
    },
    "./radio": {
      "types": "./dist/radio/radio.d.ts",
      "import": "./dist/radio/radio.js"
    },
    "./radio-group": {
      "types": "./dist/radio/radio-group.d.ts",
      "import": "./dist/radio/radio-group.js"
    },
    "./radio/define": {
      "types": "./dist/radio/define.d.ts",
      "import": "./dist/radio/define.js"
    },
    "./running-indicator": {
      "types": "./dist/running-indicator/running-indicator.d.ts",
      "import": "./dist/running-indicator/running-indicator.js"
    },
    "./running-indicator/define": {
      "types": "./dist/running-indicator/define.d.ts",
      "import": "./dist/running-indicator/define.js"
    },
    "./card": {
      "types": "./dist/card/card.d.ts",
      "import": "./dist/card/card.js"
    },
    "./card/define": {
      "types": "./dist/card/define.d.ts",
      "import": "./dist/card/define.js"
    },
    "./segmented-control": {
      "types": "./dist/segmented-control/segmented-control.d.ts",
      "import": "./dist/segmented-control/segmented-control.js"
    },
    "./segment": {
      "types": "./dist/segmented-control/segment.d.ts",
      "import": "./dist/segmented-control/segment.js"
    },
    "./segmented-control/define": {
      "types": "./dist/segmented-control/define.d.ts",
      "import": "./dist/segmented-control/define.js"
    }
  },
  "customElements": "./custom-elements.json",
  "scripts": {
    "build": "pnpm tokens && rimraf dist && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/tokens/tokens.css','dist/tokens/tokens.css');require('fs').cpSync('src/theme/theme.css','dist/theme/theme.css');require('fs').cpSync('src/theme/polish.css','dist/theme/polish.css')\"",
    "analyze": "cem analyze --config custom-elements-manifest.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test test/tokens.test.mjs && playwright test --project=chromium",
    "test:browsers": "playwright test --project=firefox --project=webkit",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --disable-telemetry -o storybook-static && node scripts/storybook-title.mjs",
    "changeset": "changeset",
    "release": "pnpm build && pnpm analyze && changeset publish",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "peerDependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@custom-elements-manifest/analyzer": "^0.10.10",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/web-components": "^8.6.14",
    "@storybook/web-components-vite": "^8.6.14",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^1.15.0",
    "eslint-plugin-lit-a11y": "^4.1.4",
    "eslint-plugin-wc": "^2.2.0",
    "globals": "^15.15.0",
    "lit": "^3.3.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "storybook": "^8.6.14",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.6"
}
